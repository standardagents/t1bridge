[Unit]
Description=T1Bridge Touch Bar renderer launcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
EnvironmentFile=-/etc/t1bridge/diagnostics.conf
Type=simple
ExecStart=/usr/lib/t1bridge/t1-touchbar
UMask=0077
NoNewPrivileges=yes

[Install]
# default.target starts the renderer with a fresh user manager;
# graphical-session.target starts it again for each later graphical session
# when the manager outlives a logout (PartOf stops it with the session).
WantedBy=default.target graphical-session.target
